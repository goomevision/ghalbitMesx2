<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtNetworkTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_monitor"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRefreshNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/refresh" />

    <TextView
        android:id="@+id/txtNetworkSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#101820"
        android:fontFamily="monospace"
        android:minLines="4"
        android:padding="12dp"
        android:textSize="15sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/networkScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#101820"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/txtNetworkNodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textSize="13sp" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
