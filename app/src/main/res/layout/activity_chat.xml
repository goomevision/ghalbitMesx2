<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ghalbit_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ghalbit_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txtChatAvatarVisual"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_name_card_badge"
            android:gravity="center"
            android:text="GN"
            android:textColor="#F5FBFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtChatHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chat GhalbitNet"
                android:textColor="#F5FBFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Online / pending"
                android:textColor="#8EE3BE"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCall"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:text="Telp"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnRetryFailed"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:text="Ulang"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtRouteHealthStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_ghalbit_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Pesan terenkripsi • menunggu status jalur"
        android:textColor="#BFD3E6"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/reviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_ghalbit_card"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/reviewContentScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtReviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tinjau sebelum kirim"
                    android:textColor="#F5FBFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtReviewInlineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ghalbit_log"
                    android:padding="8dp"
                    android:textColor="#8EE3BE"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgReviewPreview"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtReviewMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#BFD3E6"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edtReviewCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ghalbit_log"
                    android:gravity="top|start"
                    android:hint="Ubah pesan atau caption"
                    android:maxLines="3"
                    android:minLines="1"
                    android:padding="10dp"
                    android:textColor="#F5FBFF"
                    android:textColorHint="#88A8C8" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/reviewActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ghalbit_log"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btnReviewConfirm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="Kirim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReviewCancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="Batal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReviewEdit"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="Edit"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReviewReplace"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:text="Ganti"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/composerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_ghalbit_card"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtMessage"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ghalbit_log"
                android:hint="Ketik pesan"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#F5FBFF"
                android:textColorHint="#88A8C8" />

            <Button
                android:id="@+id/btnVoice"
                android:layout_width="58dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:text="Suara"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="58dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:text="Kirim"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <Button
                android:id="@+id/btnAttach"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="File"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="Foto"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnChatLocationVisual"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:enabled="false"
                android:maxLines="1"
                android:text="Lokasi"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnChatMoreVisual"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:enabled="false"
                android:maxLines="1"
                android:text="Lain"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtChatActionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Telp = panggilan • Ulang = kirim ulang pesan gagal"
            android:textColor="#88A8C8"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
