<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B18"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hotspot_blocklist_assistant_title"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotspot_blocklist_assistant_subtitle"
        android:textColor="#B6C8D8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtUnauthorizedSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotspot_blocklist_section_unauthorized"
        android:textColor="#FFD54F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#101820"
        android:padding="12dp"
        android:text="@string/hotspot_blocklist_manual_warning"
        android:textColor="#FFD54F"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterUnauthorizedClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hotspot_blocklist_filter_unauthorized" />

            <Button
                android:id="@+id/btnFilterSuspiciousClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/hotspot_blocklist_filter_suspicious" />

            <Button
                android:id="@+id/btnFilterBlockedClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/hotspot_blocklist_filter_blocked" />

            <Button
                android:id="@+id/btnFilterManualApprovedClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/hotspot_blocklist_filter_manual" />

            <Button
                android:id="@+id/btnFilterTrustedClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/hotspot_blocklist_filter_trusted" />

            <Button
                android:id="@+id/btnFilterAllClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/hotspot_blocklist_filter_all" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnOpenHotspotSettingsAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotspot_blocklist_open_settings_list" />

    <Button
        android:id="@+id/btnOpenCommunitySessionsAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/community_session_open" />

    <Button
        android:id="@+id/btnRecommendPasswordRotation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotspot_blocklist_password_rotation" />

    <TextView
        android:id="@+id/txtPasswordRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#101820"
        android:padding="12dp"
        android:textColor="#FFD54F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtHotspotClientEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#101820"
        android:padding="12dp"
        android:text="@string/hotspot_blocklist_empty"
        android:textColor="#B6C8D8"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHotspotClients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

</LinearLayout>
