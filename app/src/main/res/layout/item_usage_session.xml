<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#101820"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtUsageItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtUsageItemMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#B6C8D8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtUsageItemTraffic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#7FE7FF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtUsageItemSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFD54F"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
