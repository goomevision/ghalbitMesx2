<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ghalbit_screen"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        <TextView android:text="GHALBITMES X2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#F5FBFF"
            android:textSize="28sp" android:textStyle="bold"
            android:background="@drawable/bg_ghalbit_hero"
            android:padding="16dp"/>
        <TextView android:text="STATUS" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="16dp"/>
        <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="OFFLINE"
            android:textColor="#00FF88" android:textSize="20sp"/>
        <ProgressBar
            android:id="@+id/progressMain"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/txtUserMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ghalbit_card"
            android:minLines="2"
            android:gravity="center_vertical"
            android:text="@string/app_ready_message"
            android:textColor="#B6C8D8"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginTop="8dp" />
        <TextView android:text="KONEKSI" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="10dp"/>
        <TextView android:id="@+id/txtConnectionScope" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="OFFLINE"
            android:textColor="#7FE7FF" android:textSize="18sp"
            android:background="@drawable/bg_ghalbit_card"
            android:padding="10dp"/>
        <TextView android:text="MODE HYBRID" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="10dp"/>
        <TextView android:id="@+id/txtHybridStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Belum aktif"
            android:textColor="#9FE870" android:textSize="18sp"
            android:background="@drawable/bg_ghalbit_card"
            android:padding="10dp"/>
        <TextView android:text="ID GLOBAL" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="10dp"/>
        <TextView android:id="@+id/txtGlobalIdentity" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="GX-UNKNOWN"
            android:textColor="#FFD54F" android:textSize="16sp"
            android:background="@drawable/bg_ghalbit_card"
            android:padding="10dp"/>
        <TextView android:text="CONNECTED NODES" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="10dp"/>
        <TextView android:id="@+id/txtNodes" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0"
            android:textColor="#00D9FF" android:textSize="20sp"
            android:background="@drawable/bg_ghalbit_card"
            android:padding="10dp"/>
        <TextView android:text="PING" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="10dp"/>
        <TextView android:id="@+id/txtPing" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="--"
            android:textColor="#FFD54F" android:textSize="20sp"
            android:background="@drawable/bg_ghalbit_card"
            android:padding="10dp"/>
        <TextView android:text="BALANCE" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:paddingTop="10dp"/>
        <TextView android:id="@+id/txtBalance" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0.00 GHBT"
            android:textColor="#FFD700" android:textSize="20sp"
            android:background="@drawable/bg_ghalbit_card"
            android:padding="10dp"/>
        <Button android:id="@+id/btnMesh" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="AKTIFKAN MESH"
            android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btnChat" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="CHAT"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnSavedContacts" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/saved_contacts_short"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnMyProfile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="KARTU NAMA SAYA"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnRemoteMode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/remote_mode_short"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnNetwork" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="NETWORK MAP"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnRuntimeDashboard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/runtime_dashboard_short"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnNotifications" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/notification_settings_short"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnMediaSettings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/chat_media_settings_short"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnSOS" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="SOS"
            android:layout_marginTop="10dp"/>
        <Button
    android:id="@+id/btnMint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/service_economy_short"
    android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/debug_panel" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM LOG"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ghalbit_log"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <TextView
                android:id="@+id/txtLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="GHALBITX2 READY..."
                android:textColor="#00FF88"
                android:textSize="14sp" />

        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</LinearLayout>
